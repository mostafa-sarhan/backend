# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/shipping
PORT=5000
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# production | development | test
NODE_ENV=development
LOG_LEVEL=info
# Run the hourly archive job in the API process (false = use `npm run archive` from cron)
RUN_JOBS=true
# Auth cookies. COOKIE_SECURE=false only for local http testing on non-localhost hosts.
COOKIE_SECURE=true
# strict | lax | none  (none only if the frontend is on a different site; requires COOKIE_SECURE=true)
COOKIE_SAMESITE=strict
# Optional, e.g. .example.com to share cookies between app. and api. subdomains
COOKIE_DOMAIN=
# Default fees per delivered order (until fees are stored per company)
DEFAULT_COURIER_FEE=20
DEFAULT_COMPANY_FEE=20
EXPORT_MAX_ROWS=5000
# Name of the tenant created from existing single-company data by `npm run migrate`
DEFAULT_TENANT_NAME=Fast Express

# ---- Reverse proxy & request limits ----
# Number of reverse proxies in front of the API (e.g. 1 for nginx). Never "true".
TRUST_PROXY=0
BODY_LIMIT=100kb

# ---- Rate limiting ----
# Store: memory (one process) by default; REDIS_URL or RATE_LIMIT_STORE=mongo for several processes.
REDIS_URL=
RATE_LIMIT_STORE=memory
RATE_LIMIT_GLOBAL_PER_15MIN=1000
RATE_LIMIT_LOGIN_IP_PER_15MIN=20
RATE_LIMIT_PLATFORM_LOGIN_IP_PER_15MIN=5
LOGIN_LOCK_AFTER_FAILURES=5
PLATFORM_LOGIN_LOCK_AFTER_FAILURES=3
RATE_LIMIT_REFRESH_IP_PER_15MIN=60
RATE_LIMIT_PASSWORD_CHANGE_PER_15MIN=5
RATE_LIMIT_USER_PER_MIN=300
RATE_LIMIT_TENANT_PER_MIN=3000
RATE_LIMIT_MERCHANT_KEY_PER_MIN=60
RATE_LIMIT_TRACKING_IP_PER_MIN=20
RATE_LIMIT_ACCESS_REQUEST_IP_PER_HOUR=5
RATE_LIMIT_EXPORT_USER_PER_HOUR=30
RATE_LIMIT_IMPORT_USER_PER_HOUR=10
