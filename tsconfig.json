{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "commonjs",
    "target": "ES2020",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["node", "dotenv"],
    "typeRoots": ["./node_modules/@types", "./src/types"]

  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
